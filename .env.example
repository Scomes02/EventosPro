# Copiá este archivo como .env.local para trabajar en tu PC.
# En Vercel, estas variables se cargan en Project Settings → Environment Variables.

# Cadena de conexión de PostgreSQL (Neon, Supabase o local)
DATABASE_URL=postgres://usuario:password@host:5432/eventos

# Texto largo y aleatorio para firmar las sesiones. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Clave para entrar al panel /#/admin
ADMIN_KEY=
